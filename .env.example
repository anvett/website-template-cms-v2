# Copiar a .env.local y completar. .env* nunca se commitea (ver
# .gitignore) salvo este propio archivo de ejemplo.
#
# Estas variables SOLO aplican a instancias con CMS activo (cronograma
# Fase 3.2, ver src/lib/cms/README.md). Una instancia sin CMS (la mayoría
# — informativa, static export + cPanel, ver docs/decisions/
# decision-log.md "Static export + cPanel vs. Vercel dinámico + ISR") no
# necesita nada de esto: sigue usando los archivos de src/data/ como
# siempre.

# URL base del backend Django compartido (sin slash final). Local:
# http://localhost:8000 — producción/staging: la URL de Render.
CMS_API_URL=http://localhost:8000

# Slug de ESTA instancia en el backend multi-tenant (ej. "kautela").
# Tiene que existir como Site en el backend antes de usar esto.
CMS_SITE_SLUG=

# Token de lectura de este Site (content_admin.models.SiteReadToken) —
# se genera desde Django Admin, inline dentro del Site. Secreto real:
# nunca con prefijo NEXT_PUBLIC_, nunca commiteado en .env real.
CMS_API_TOKEN=

# --- Storefront (Fase 0/1, ver docs/decisions/
# CATALOGO-AVANZADO-VEHICULAR-ROADMAP.md) --------------------------------
# Cuentas de cliente y carrito: register/login/logout/me/orders son
# endpoints públicos (sin CMS_API_TOKEN) porque el navegador los llama
# directo, no src/lib/cms/ (que es server-only). Por eso necesitan la
# variante NEXT_PUBLIC_ — mismos valores que CMS_API_URL/CMS_SITE_SLUG de
# arriba, no son secretos nuevos, solo expuestos al cliente a propósito.
# Si esta instancia no tiene backend de storefront desplegado, dejar
# vacío: CartWidget/CustomerSession no se renderizan (ver
# src/lib/storefront/env.js, isStorefrontEnabled()).
NEXT_PUBLIC_CMS_API_URL=
NEXT_PUBLIC_CMS_SITE_SLUG=

# --- Editor Anvetcorp: preview embebido (Bloque E4, DW-008) -----------
# Origin EXACTO (esquema + host + puerto) del deploy de Editor
# Anvetcorp que tiene permitido embeber esta instancia en un iframe
# para preview/edición. Controla dos cosas a la vez: el
# `frame-ancestors` de la CSP (ver next.config.mjs, headers()) y el
# `targetOrigin` que usa `EditorBridge` (src/components/editor/
# EditorBridge.jsx) para el postMessage de click-a-Section -- NUNCA
# "*", nunca ningún valor tomado de la URL/query string (ver
# DECISIÓN PO 2 de DW-008/Bloque E4: el origin del Editor tiene que
# ser configuración explícita de esta instancia, nunca confiado desde
# el propio iframe). Vacío/sin setear = sin framing permitido
# (`frame-ancestors 'self'`) y bridge inactivo.
NEXT_PUBLIC_ANVETCORP_EDITOR_ORIGIN=
